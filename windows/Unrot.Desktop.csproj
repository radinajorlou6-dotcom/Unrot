<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Unrot</AssemblyName>
    <RootNamespace>Unrot</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Product>Unrot</Product>
    <Description>Earn your game time</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\icons\*.png" LogicalName="icons/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\fonts\*.ttf" LogicalName="fonts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
